# Setup generates .env with random local-only credentials. Do not use these example values.
# Exact image digests used by the structural verification milestone.
POSTGRES_IMAGE=postgres@sha256:10a5c69a83035ab5239f5620d708520e8b28f5aa1f2b20143e6024532edadfb5
MONGO_IMAGE=mongo@sha256:b9924c330a8bbc5800fe9c69f04a84e221eca7b28fd049a0354147d9908fa142
POSTGRES_USER=fieldmerge_owner
POSTGRES_PASSWORD=replace_with_random_local_password
MONGO_INITDB_ROOT_USERNAME=fieldmerge_root
MONGO_INITDB_ROOT_PASSWORD=replace_with_another_random_local_password
POSTGRES_PORT=15432
MONGO_PORT=27018

# pnpm configure:backend appends generated API_POSTGRES_PASSWORD, API_MONGO_PASSWORD,
# DATABASE_URL, MONGODB_URI, MONGODB_DATABASE and APP_ORIGIN to your ignored .env.
# The API uses fieldmerge_api accounts, never the owner/root logins above.
# The same command also provisions fieldmerge_worker and saves WORKER_POSTGRES_PASSWORD,
# WORKER_MONGO_PASSWORD, WORKER_DATABASE_URL and WORKER_MONGODB_URI for pnpm worker.
