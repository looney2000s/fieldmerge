    {
      "id": "Q09",
      "title": "Intervening edits including reversals: window LAG + null-aware comparison.",
      "sql": "WITH revisions AS (\n  SELECT version_no,health,\n         lag(health) OVER(ORDER BY version_no) AS previous_health\n  FROM fieldmerge.accepted_versions WHERE record_id=$1\n)\nSELECT version_no,health,previous_health,\n       version_no>1 AND health IS DISTINCT FROM previous_health AS actually_changed\nFROM revisions ORDER BY version_no;",
      "parameters": [
        "51000000-0000-4000-8000-000000000001"
      ],
      "client": {
